{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cokacremote Manager RC",
  "version": "0.5.0-rc.2",
  "identifier": "io.github.cokacremote.desktop.rc",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/prepare-tauri.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "cokacremote Manager RC — Live Trial",
        "width": 1160,
        "height": 785,
        "minWidth": 960,
        "minHeight": 680,
        "decorations": false,
        "backgroundColor": "#e9eeed"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png"
    ],
    "resources": [
      "resources/platform/mac/status.mjs",
      "resources/platform/mac/operate.mjs",
      "resources/platform/mac/supervisor.mjs",
      "resources/platform/mac/boot-worker.mjs",
      "resources/platform/mac/dependencies.mjs",
      "resources/platform/mac/install-deps.mjs",
      "resources/platform/mac/native-sandbox.mjs",
      "resources/platform/mac/sandbox-worker.mjs",
      "resources/platform/mac/sandbox-proxy.mjs",
      "resources/platform/mac/sandbox-cli.mjs",
      "resources/manager-build-mode.json",
      "resources/core/reconcile.mjs",
      "resources/core/mac-setup-controller.mjs",
      "resources/core/mac-agent-policy.mjs",
      "resources/embedded-core.tgz"
    ]
  }
}
