{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cokacremote Manager",
  "version": "0.4.0-rc.1",
  "identifier": "io.github.cokacremote.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/prepare-tauri.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "cokacremote / Connection Manager",
        "width": 1160,
        "height": 785,
        "minWidth": 940,
        "minHeight": 670,
        "decorations": false,
        "backgroundColor": "#e9eeed"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": [
      "resources/platform/mac/status.mjs",
      "resources/platform/mac/operate.mjs",
      "resources/platform/mac/supervisor.mjs",
      "resources/core/reconcile.mjs",
      "resources/bootstrap/macos.sh"
    ]
  }
}
