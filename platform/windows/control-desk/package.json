{
  "name": "cokacremote-control-desk",
  "version": "0.6.0",
  "description": "Windows desktop Control Desk for the local cokacremote MCP service",
  "private": true,
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "pack:win": "electron-builder --win dir --x64 --publish never",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.18.0"
  }
}
