{
  "name": "cokacremote-desktop",
  "version": "0.2.0",
  "description": "Cross-platform MCP connection manager for existing cokacremote services",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "electron .",
    "package:mac": "electron-packager . 'cokacremote Manager' --platform=darwin --arch=arm64 --out=dist --overwrite --ignore='^/dist$' --ignore='^/.git$' --ignore='^/release$' --app-bundle-id=io.github.cokacremote.desktop --icon=assets/app-icon.icns"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "@electron/packager": "19.0.1"
  }
}
